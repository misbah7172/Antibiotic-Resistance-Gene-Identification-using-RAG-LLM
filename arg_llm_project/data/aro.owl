    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009148</IRI>
        <Literal>MexJK</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009149</IRI>
        <Literal>MexMN is a multidrug efflux pump complex consisting of MexM and MexN as its main components. This system acts as a central transport mechanism, partnering with outer membrane proteins to expel antibiotics and toxic compounds, thereby playing a significant role in multidrug resistance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
