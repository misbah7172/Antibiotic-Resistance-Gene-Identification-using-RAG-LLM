        <IRI>http://purl.obolibrary.org/obo/ARO_0000076</IRI>
        <Literal>resistance-modifying agents</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_0000077</IRI>
        <Literal>Tazobactam is a compound which inhibits the action of bacterial beta-lactamases.</Literal>
    </AnnotationAssertion>
