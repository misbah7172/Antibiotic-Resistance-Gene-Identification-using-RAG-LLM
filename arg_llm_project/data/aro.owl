    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3004880</IRI>
        <Literal>pyrazinamide resistant gpsI</Literal>
    </AnnotationAssertion>
