        <IRI>http://purl.obolibrary.org/obo/ARO_3003278</IRI>
        <Literal>ARO:3003278</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003278</IRI>
        <Literal>daptomycin sensitive beta-subunit of RNA polymerase (rpoB)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
