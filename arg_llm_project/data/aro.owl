        <IRI>http://purl.obolibrary.org/obo/ARO_3003414</IRI>
        <Literal>LFF571</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003415</IRI>
        <Literal>Point mutations in dihydropteroate synthase folP prevent sulfonamide antibiotics from inhibiting its role in folate synthesis, thus conferring sulfonamide resistance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003415</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003415</IRI>
        <Literal>ARO:3003415</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003415</IRI>
        <Literal>sulfonamide resistant dihydropteroate synthase folP</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003416</IRI>
        <Literal>Bifunctional enzyme with both catalase and broad-spectrum peroxidase activity. It is a catalase-peroxidases that catalyzes the activation of isoniazid. Mutations that arises within this protein cause changes that results in the inability for katG to activate antibiotics, conferring resistance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003416</IRI>
        <Literal>catalase-peroxidases</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003416</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003416</IRI>
        <Literal>ARO:3003416</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003416</IRI>
        <Literal>isoniazid resistant katG</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
            <Literal>PMID:8284673</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003417</IRI>
        <Literal>inhA is a enoyl-acyl carrier reductase used in lipid metabolism and fatty acid biosynthesis. It is inhibited by isoniazid. Mutations in the promoter region or multiple copies of the inhA shows marked resistance to isoniazid mediated inhibition of mycolic acid biosynthesis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003417</IRI>
        <Literal>enoyl-acyl carrier reductase</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003417</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003417</IRI>
        <Literal>ARO:3003417</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003417</IRI>
        <Literal>antibiotic resistant inhA</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
            <Literal>PMID:9055989</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3003418</IRI>
        <Literal>pncA is a pyrazinamidase/nicotinamidase. It catalyzes the activation of pyrazinamide to pyrazinoic acid. Mutations arise within the pncA gene that caused the loss of pyrazinamidase activity is the major mechanism of antibiotic resistance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
