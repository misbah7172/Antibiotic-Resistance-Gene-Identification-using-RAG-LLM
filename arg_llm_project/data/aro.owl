    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007690</IRI>
        <Literal>antibiotic resistant Rv2535c</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
            <Literal>PMID:27185800</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007691</IRI>
        <Literal>Loss-of-function mutations in Rv2535c are a common mechanism of resistance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007691</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007691</IRI>
        <Literal>ARO:3007691</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007691</IRI>
        <Literal>bedaquiline resistant Rv2535c</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
            <Literal>PMID:27185800</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007692</IRI>
        <Literal>These pepQ/Rv2535c mutations increase efflux through the mmpL5-mmpS5 (Rv0676c-Rv0677c) transporter, such as preventing degradation of MmpL5, which leads to reduced susceptibility to bedaquiline and clofazimine.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasSynonymType"/>
            <IRI>http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name</IRI>
        </Annotation>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007692</IRI>
        <Literal>Mtub_Rv2535_BDQ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007692</IRI>
        <Literal>Rv2535c</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
