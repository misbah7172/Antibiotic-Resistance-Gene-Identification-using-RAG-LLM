        <Literal>aminosalicylate resistant thymidylate synthase</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
            <Literal>PMID:25421465</Literal>
        </Annotation>
        <Annotation>
