            <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
            <Literal>PMID:29398560</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3007209</IRI>
        <Literal>Streptomyces venezuelae rox is a class A flavoprotein monooxygenase that confers resistance to rifamycin antibiotics. It acts by oxygenating the naphthyl group of the antibiotic, leading to a ring opening event and linearization of the molecule.</Literal>
    </AnnotationAssertion>
