        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3004054</IRI>
        <Literal>CpxR is directly involved in activation of expression of RND efflux pump MexAB-OprM in P. aeruginosa. CpxR is required to enhance mexAB-oprM expression and drug resistance, in the absence of repressor MexR.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
