    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009105</IRI>
        <Literal>First-generation cephalosporin antibiotics include those with a relatively narrow spectrum of activity, primarily effective against gram-positive cocci and with minimal coverage against gram-negative bacteria.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009105</IRI>
        <Literal>1st-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009105</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009105</IRI>
        <Literal>ARO:3009105</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009105</IRI>
        <Literal>first-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009106</IRI>
        <Literal>Second-generation cephalosporin antibiotics have increased efficacy against gram-negative bacteria compared to first-generation cephalosporins. This subclass also includes cephamycin antibiotics.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009106</IRI>
        <Literal>2nd-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009106</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009106</IRI>
        <Literal>ARO:3009106</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009106</IRI>
        <Literal>second-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009107</IRI>
        <Literal>Third generation cephalosporin antibiotics have a marked activity against gram-negative bacteria, but diminished activity against gram-positive bacteria.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009107</IRI>
        <Literal>3rd-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009107</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009107</IRI>
        <Literal>ARO:3009107</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009107</IRI>
        <Literal>third-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009108</IRI>
        <Literal>Fourth-generation cephalosporins have activity against gram-positive cocci and a broad array of gram-negative bacteria, including Pseudomonas and many of the Enterobacteriaceae with inducible chromosomal beta-lactamases.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009108</IRI>
        <Literal>4th-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009108</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009108</IRI>
        <Literal>ARO:3009108</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009108</IRI>
        <Literal>fourth-generation cephalosporin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009109</IRI>
        <Literal>This subfamily includes other penem and cephalosporin antibiotics without defined classification by generation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#hasOBONamespace"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009109</IRI>
        <Literal>antibiotic_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.geneontology.org/formats/oboInOwl#id"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009109</IRI>
        <Literal>ARO:3009109</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009109</IRI>
        <Literal>other cephalosporins and penems</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.obolibrary.org/obo/ARO_3009110</IRI>
        <Literal>Cefazedone is a semisynthetic first-generation cephalosporin with antibacterial activity. Cefazedone binds to and inactivates penicillin-binding proteins (PBPs) located on the inner membrane of the bacterial cell wall.</Literal>
